{
  "log": {
    "loglevel": "none"
  },
  "inbounds": [
    {
      "tag": "tun-socks",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true,
        "ip": "127.0.0.1"
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "http",
      "settings": {
        "servers": [
          {
            "address": "192.0.2.1",
            "port": 8080,
            "users": [
              {
                "user": "test",
                "pass": "fixture-only"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "none"
      },
      "mux": {
        "enabled": false
      }
    },
    {
      "tag": "dns-out",
      "protocol": "dns",
      "settings": {
        "network": "tcp",
        "address": "1.1.1.1",
        "port": 53,
        "nonIPQuery": "skip"
      },
      "proxySettings": {
        "tag": "proxy"
      }
    }
  ],
  "policy": {
    "levels": {
      "0": {
        "handshake": 8,
        "connIdle": 120,
        "uplinkOnly": 2,
        "downlinkOnly": 2,
        "bufferSize": 4
      }
    }
  },
  "dns": {
    "servers": [
      "https://1.1.1.1/dns-query"
    ],
    "disableCache": true,
    "tag": "dns-query"
  },
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "tun-socks"
        ],
        "port": "53",
        "outboundTag": "dns-out"
      }
    ]
  }
}
